CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_MODULES=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_MMIO=y
CONFIG_EXT4_FS=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_TTY=y
CONFIG_MALI_MIDGARD=m
CONFIG_MALI_CSF_SUPPORT=y
CONFIG_MALI_EXPERT=y
CONFIG_MALI_NO_MALI=y
# CONFIG_MALI_REAL_HW is not set
CONFIG_MALI_NO_MALI_DEFAULT_GPU="tKRx"
CONFIG_MALI_PLATFORM_NAME="devicetree"

# Bug bounty eligibility: arm64 requires exactly one page size to be selected.
# Pinned explicitly so the reproducing config is not left to olddefconfig's
# default choice. See docs/build.md.
CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_16K_PAGES is not set

CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_STACKDEPOT=y
CONFIG_STACKDEPOT_ALWAYS_INIT=y

# Bug bounty eligibility: the permitted deviations from the default config
# exclude the KASAN and UBSAN self-tests. Enabling any *_TEST variant to get
# "more coverage" makes a result ineligible for submission, so they are pinned
# off here rather than left to whatever olddefconfig would pick.
# See docs/build.md.
# CONFIG_KASAN_GENERIC_TEST is not set
# CONFIG_KASAN_SW_TAGS_TEST is not set
# CONFIG_KASAN_VMALLOC_TEST is not set
# CONFIG_KASAN_KUNIT_TEST is not set
# CONFIG_TEST_UBSAN is not set
