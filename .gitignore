downloads/
work/
build/*
!build/.gitkeep
# dist/ is the packaged lab: ~167 MB of build outputs. Fully generated by
# 'make dist' from build/, including run.sh, which is copied from
# scripts/dist-run.sh rather than tracked in place so wiping dist/ can never
# destroy a tracked file.
dist/
*.o
*.ko
*.dtb
*.img
*.cpio
*.tar
results/crashes/*
results/warnings/*
results/kasan/*
results/lockdep/*
results/dmesg/*
results/reports/*
results/*.json
__pycache__/
