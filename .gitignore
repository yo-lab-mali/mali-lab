# regenerable workspaces and downloads (kept out of git; they are large and
# reproducible from docs/build.md)
work/
downloads/
driver/
build/*
!build/.gitkeep

# dist/ IS committed: it is the portable, prebuilt lab. Do not re-add a bare
# `dist/` line here, and do not ignore dist/*.dtb / dist/*.ko / dist/*.gz.

# node-local scratch and decompressed cache for dist/run.sh
dist/.run/
dist/.cache/

# P0 result outputs that the guest run regenerates
results/crashes/*
results/warnings/*
results/kasan/*
results/lockdep/*
results/dmesg/*
results/reports/*
results/*.json

*.o
__pycache__/
